# 비밀값과 개인 PC 환경 설정 (예시 파일은 공유)
.env
.env.*
!.env.example
!.env.*.example
*.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Python 가상환경, 캐시, 로컬 데이터와 학습 결과
나중에 건드려야함

# IntelliJ IDEA
**/.idea/
*.iml
*.iws
*.ipr

# VS Code
**/.vscode/*
!**/.vscode/extensions.json

# 운영체제 임시 파일
**/.DS_Store
**/Thumbs.db

# 로컬 작업 중 생성되는 임시 파일
.tmp/

# Vim 편집기 임시 파일
*.swp
*.swo

# 실행 로그
*.log
*.log.*
**/logs/

# 다운로드 파일
workers

# 실행 위치에 따라 생기는 사용자 업로드와 세무 PDF 원본은 공유하지 않는다.
/storage/tax-pdfs/
/back/storage/tax-pdfs/

# 프론트엔드 전용 제외 규칙
/front/**/node_modules
/front/**/dist
/front/**/dist-ssr
/front/**/*.local

# Editor directories and files
/front/**/*.suo
/front/**/*.ntvs*
/front/**/*.njsproj
/front/**/*.sln
/front/**/*.sw?

# 로컬 이전 백업과 npm 캐시는 저장소에 올리지 않는다.
/front/**/migration-backup/
/front/**/.npm-cache/

# 백엔드 전용 제외 규칙
/back/**/HELP.md
/back/**/.gradle
/back/**/build/
!/back/gradle/wrapper/gradle-wrapper.jar
!/back/**/src/main/**/build/
!/back/**/src/test/**/build/

# Maven 빌드 결과와 Java 컴파일 파일
/back/**/target/
/back/**/*.class

# 사용자 업로드 파일

### STS ###
/back/**/.apt_generated
/back/**/.classpath
/back/**/.factorypath
/back/**/.project
/back/**/.settings
/back/**/.springBeans
/back/**/.sts4-cache
/back/**/bin/
!/back/**/src/main/**/bin/
!/back/**/src/test/**/bin/

### IntelliJ IDEA ###
/back/**/out/
!/back/**/src/main/**/out/
!/back/**/src/test/**/out/

### NetBeans ###
/back/nbproject/private/
/back/nbbuild/
/back/dist/
/back/nbdist/
/back/.nb-gradle/

# 개인 JWT 서명 키 (Git에 올리지 않는다)
/back/config/jwt-secret.properties

# 테스트 소스는 로컬에서만 관리한다.
/back/src/test/

# 로컬 SQL 자료는 Git에 올리지 않는다.
/back/sql/schema.sql
/back/local/

# 업로드는 제외하고 현재 저장 위치의 기본 프로필 이미지 하나만 공유한다.
**/uploads/
!/uploads/
/uploads/*
!/uploads/profile/
/uploads/profile/*
!/uploads/profile/default-profile.svg
